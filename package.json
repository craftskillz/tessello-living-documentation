{
  "name": "@craftskillz/living-documentation",
  "version": "1.0.0",
  "private": true,
  "description": "Raw Markdown documentation next to your code, readable by your agents: read, edit and organize it in Tessello.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "test": "node --test \"test/*.test.ts\"",
    "test:browser": "npm run build && node --test --test-concurrency=1 \"e2e/*.test.ts\"",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.2",
    "@tessello/sdk": "0.3.0",
    "buffer": "^6.0.3",
    "codemirror": "^6.0.2",
    "isomorphic-git": "^1.44.19",
    "mermaid": "^11.17.2",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "playwright": "^1.65.0",
    "svelte": "^5.57.2",
    "tessello": "0.5.0",
    "typescript": "~5.9.3"
  }
}
